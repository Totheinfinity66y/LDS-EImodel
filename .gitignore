# Full extracted publication text, source snapshots and page-review workspaces
# remain persistent local evidence, not redistributed with repository changes.
audit/paper2agent/**/paper-review/
audit/paper2agent/**/review-aid/*/*.jpg
artifacts/paper2agent_reproduction/references/
artifacts/paper2agent_reproduction/reproduced_papers/*/*-paper/
