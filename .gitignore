handcrafted_ei/artifacts/v1/*/
# Local full-state perturbation recordings are reproducible and hash-indexed.
# Keep these large NPZs on disk; summary.json and CSVs are versioned.
artifacts/neural_representation_v2/data/dynamics/*.npz
# Copyrighted reference PDFs/figures are local verification material only.
artifacts/neural_representation_v2/reference_evidence/
# Full source publications and upstream snapshots stay local, hash-indexed.
audit/paper2agent/*/upstream/
audit/paper2agent/**/*.zip
